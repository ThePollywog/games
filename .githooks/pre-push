#!/bin/sh
# Refuses pushes to anything but ThePollywog on GitHub, and pushes carrying a commit whose author
# or committer is not thepollywog <thepollywog@proton.me>.
NAME=thepollywog
EMAIL=thepollywog@proton.me
remote=$1
url=$2
case $url in
  *github.com-thepollywog* | *github.com:ThePollywog/* | *github.com/ThePollywog/*) ;;
  *)
    echo "pre-push: $remote ($url) is not a ThePollywog remote." >&2
    exit 1
    ;;
esac
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac # deleting a branch
  case $remote_sha in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes=$remote" ;;
  esac
  # shellcheck disable=SC2086
  bad=$(git log --format='%h%x09%an%x09%ae%x09%cn%x09%ce' $range |
    awk -F '\t' -v n="$NAME" -v e="$EMAIL" '$2 != n || $3 != e || $4 != n || $5 != e { print $1 ": " $2 " <" $3 "> / " $4 " <" $5 ">" }')
  if [ -n "$bad" ]; then
    echo "pre-push: $local_ref has commits not authored and committed as $NAME <$EMAIL>:" >&2
    echo "$bad" >&2
    status=1
  fi
done
[ $status -eq 0 ] || echo "Run activate-thepollywog, rewrite those commits, and push again." >&2
exit $status
